{
  "name": "@local/dsh-balance-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Session spend and DeepSeek account balance indicators for DSH.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Asukabye/dsh-balance-ui.git"
  },
  "homepage": "https://github.com/Asukabye/dsh-balance-ui#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "balance"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "LICENSE",
    "docs",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
